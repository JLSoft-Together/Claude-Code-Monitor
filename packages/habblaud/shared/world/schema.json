{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://server.habblaud.com/protocol/v1/world-uplink.json",
  "title": "WorldUplink",
  "description": "Pacote do prédio que sobe do computador para o Habblaud World (WorldUplink em shared/world/protocol.ts; o que sai e o que nunca sai: docs/world/privacidade.md). Escrito à mão e estrito: qualquer campo fora da lista derruba o pacote inteiro. Limites que o JSON Schema não expressa (total de 256 agentes, 64 KB, ids repetidos, nome no pool, peças nas paletas) são conferidos no código do servidor do mundo. Fonte da verdade: este arquivo, no repositório público do Habblaud; o servidor guarda uma cópia exata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "version", "theme", "floors"],
  "properties": {
    "v": { "const": 1 },
    "version": {
      "description": "Versão do Habblaud (semver, com pré-lançamento opcional).",
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}(-[0-9A-Za-z.-]{1,16})?$"
    },
    "theme": { "$ref": "#/$defs/theme" },
    "floors": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/floor" }
    },
    "tokens": {
      "description": "Total do prédio (entrada + saída), arredondado a 2 algarismos no cliente; ausente se desligado.",
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "week"],
      "properties": {
        "day": { "$ref": "#/$defs/tokenCount" },
        "week": { "$ref": "#/$defs/tokenCount" }
      }
    }
  },
  "$defs": {
    "theme": { "enum": ["none", "halloween", "christmas"] },
    "tokenCount": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
    "floorId": { "type": "string", "pattern": "^f_[0-9a-f]{10}$" },
    "agentId": { "type": "string", "pattern": "^a_[0-9a-f]{8}$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agents"],
      "properties": {
        "id": { "$ref": "#/$defs/floorId" },
        "agents": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/agent" }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "provider", "status", "look", "name", "parts"],
      "properties": {
        "id": { "$ref": "#/$defs/agentId" },
        "kind": { "enum": ["main", "sub"] },
        "parentId": { "$ref": "#/$defs/agentId" },
        "provider": { "enum": ["claude", "codex"] },
        "status": { "enum": ["working", "waiting", "idle", "shell"] },
        "look": { "enum": ["f", "m"] },
        "name": {
          "description": "Nome sorteado do pool (pickName), com sufixo numérico opcional quando o pool esgota. A conferência contra o pool fica no código do servidor.",
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^\\p{L}[\\p{L}' -]{0,19}( [0-9]{1,3})?$"
        },
        "parts": { "$ref": "#/$defs/parts" },
        "tasksDone": { "enum": [0, 1, 2, 3] },
        "compacted": { "const": true }
      },
      "if": { "properties": { "kind": { "const": "sub" } } },
      "then": { "properties": { "parentId": { "$ref": "#/$defs/agentId" } } },
      "else": { "properties": { "parentId": false } }
    },
    "parts": {
      "description": "Aparência achatada (as 13 peças de PART_KEYS do público); a conferência contra as paletas do editor fica no código do servidor.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skin": { "$ref": "#/$defs/color" },
        "hair": { "$ref": "#/$defs/color" },
        "hairStyle": {
          "enum": ["short", "buzz", "spiky", "side_part", "curly", "afro", "bob", "long", "ponytail", "bun", "pigtails", "mohawk", "bald", "wavy"]
        },
        "eyes": { "$ref": "#/$defs/color" },
        "top": { "$ref": "#/$defs/color" },
        "topAccent": { "$ref": "#/$defs/color" },
        "topStyle": { "enum": ["tshirt", "hoodie", "shirt_tie", "sweater", "jacket", "blouse", "polo"] },
        "bottom": { "$ref": "#/$defs/color" },
        "bottomStyle": { "enum": ["pants", "shorts", "skirt"] },
        "shoes": { "$ref": "#/$defs/color" },
        "accessory": { "enum": ["none", "glasses", "sunglasses", "headphones", "cap", "beanie", "earrings", "bow"] },
        "accessoryColor": { "$ref": "#/$defs/color" },
        "facialHair": { "enum": ["none", "stubble", "beard", "mustache", "goatee"] }
      }
    }
  }
}
