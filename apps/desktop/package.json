{
  "name": "@ccm/desktop",
  "version": "2.2.0",
  "private": true,
  "description": "Agent Monitor desktop app (Windows, macOS)",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron stage",
    "start:dev": "node build.mjs && electron stage --dev-url=http://127.0.0.1:5173",
    "dist": "node build.mjs && electron-builder --win --config electron-builder.yml --publish never",
    "typecheck": "tsc -p tsconfig.json",
    "dist:mac": "node build.mjs && electron-builder --mac --config electron-builder.yml --publish never",
    "test": "vitest run",
    "e2e": "node e2e/run.cjs"
  },
  "devDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@types/node": "^24.9.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
