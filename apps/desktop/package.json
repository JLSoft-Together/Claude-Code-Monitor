{
  "name": "@ccm/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Claude Code Monitor desktop app (Windows, macOS)",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron stage",
    "dist": "node build.mjs && electron-builder --win --config electron-builder.yml --publish never",
    "typecheck": "tsc -p tsconfig.json",
    "dist:mac": "node build.mjs && electron-builder --mac --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
